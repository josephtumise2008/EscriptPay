# Backend environment (copy to .env — never commit the real .env)
# Placeholders only. Real values go in backend/.env locally and in the hosting
# provider's environment settings in production.

# ---- LOCAL DEVELOPMENT ----
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/escriptpay
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Origins allowed for credentialed CORS (comma-separated allowed).
CLIENT_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Public URL of the frontend; Paystack redirects to $APP_URL/payment/callback.
# Defaults to the first CLIENT_ORIGIN when unset.
APP_URL=http://localhost:3000

# ---- PAYMENT ----
# test     = simulated, no gateway, no money (default)
# paystack = Paystack checkout. Use a TEST secret key (sk_test_...) only.
PAYMENT_SERVICE=test
# Paystack secret key — backend only, never NEXT_PUBLIC_*, never committed.
# Also used to verify webhook signatures.
PAYSTACK_SECRET_KEY=
# A live key (sk_live_...) is refused unless this is "true". Leave false.
LIVE_PAYMENTS_ENABLED=false
# Unpaid checkouts older than this are marked expired (a later verified
# payment still completes them).
PAYMENT_EXPIRY_MINUTES=60

# ---- DELIVERY (VTU) ----
# test        = simulated delivery (default)
# clubkonnect = REAL airtime/data via ClubKonnect. Only starts together with
#               LIVE Paystack payments + LIVE_PAYMENTS_ENABLED=true, because
#               test payments must never receive real airtime/data.
VTU_SERVICE=test
# Required "true" before any real supplier can be enabled. Leave false.
LIVE_DELIVERY_ENABLED=false
# ClubKonnect credentials (clubkonnect.com → API). Backend only, never
# NEXT_PUBLIC_*, never committed. For the local admin scripts
# (npm run vtu:balance / vtu:plans / vtu:test-order) put them in
# backend/.env.clubkonnect instead (Git ignores it).
CLUBKONNECT_USER_ID=
CLUBKONNECT_API_KEY=
# Seconds between supplier status checks for one pending order.
VTU_STATUS_CHECK_INTERVAL_SECONDS=20

# ---- PRODUCTION / VERCEL (set these in the Vercel Environment Variables UI) ----
# MONGO_URI=<MongoDB Atlas connection string>   (never commit the real value)
# JWT_SECRET=<strong private secret>
# CLIENT_ORIGIN=https://<your-vercel-domain>
# APP_URL=https://<your-vercel-domain>
# COOKIE_SECURE=true
# JWT_EXPIRES_IN=7d
# NODE_ENV=production

# ---- AUTOMATED TESTS ONLY ----
# Integration tests use a separate database whose name MUST end in _test
# (they drop it). They never use MONGO_URI. Set it in your shell, not here:
#   MONGO_URI_TEST=mongodb://127.0.0.1:27017/escriptpay_test npm run test:integration

# ---- EMAIL (verification codes, password resets) ----
# Resend (resend.com). Without these, verification is switched off and emails
# are printed to the server console in development instead of being sent.
RESEND_API_KEY=
# Sender address on a domain verified in Resend.
EMAIL_FROM="EscriptPay <no-reply@escriptpay.com>"
# Set to "off" to stop requiring email verification even when email works.
EMAIL_VERIFICATION=

# ---- WALLET TOP-UP FEE (only with PAYMENT_SERVICE=paystack) ----
# The customer pays the card processing fee on top of the top-up amount.
# Defaults match Paystack's published NGN pricing.
WALLET_FEE_ENABLED=true
# WALLET_FEE_PERCENT=1.5
# WALLET_FEE_FLAT_NAIRA=100
# WALLET_FEE_FLAT_THRESHOLD_NAIRA=2500
# WALLET_FEE_CAP_NAIRA=2000

# ---- PROFIT REPORTS ----
# Estimated supplier discount on airtime (%) until ClubKonnect reports the
# exact amount charged. Defaults from ClubKonnect's airtime API page.
# AIRTIME_DISCOUNT_MTN=3
# AIRTIME_DISCOUNT_AIRTEL=3
# AIRTIME_DISCOUNT_GLO=8
# AIRTIME_DISCOUNT_9MOBILE=7

# Card payments are only accepted from cards issued in these countries.
# Default NG. "*" accepts any country.
# ALLOWED_CARD_COUNTRIES=NG

# Scheduled checks: GET /api/cron/sweep with "Authorization: Bearer <CRON_SECRET>".
# Use a long random value (secret). Without it the endpoint is disabled.
# CRON_SECRET=
# Owner alerts (needs-review orders, low supplier balance). Defaults to admin accounts.
# ALERT_EMAIL=you@example.com
# LOW_BALANCE_ALERT_NAIRA=3000
