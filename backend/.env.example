# Backend environment (copy to .env — never commit the real .env)
#
# ---- LOCAL DEVELOPMENT ----
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/escriptpay
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Origins allowed for credentialed CORS (comma-separated allowed).
CLIENT_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# ---- PRODUCTION / VERCEL (set these in the Vercel Environment Variables UI) ----
# MONGO_URI=<MongoDB Atlas connection string>   (never commit the real value)
# JWT_SECRET=<strong private secret>
# CLIENT_ORIGIN=https://<your-vercel-domain>
# COOKIE_SECURE=true
# JWT_EXPIRES_IN=7d
# NODE_ENV=production

# Payment / VTU provider selection.
# "test" = simulated (no real money or data). Real providers (e.g. Paystack,
# GSubz, VTU Fast) are added as new files in src/services/* and selected here.
# Staging stays on "test".
PAYMENT_SERVICE=test
VTU_SERVICE=test
