# Backend environment (copy to .env — never commit the real .env)
# Placeholders only. Real values go in backend/.env locally and in the hosting
# provider's environment settings in production.

# ---- LOCAL DEVELOPMENT ----
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/escriptpay
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Origins allowed for credentialed CORS (comma-separated allowed).
CLIENT_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Public URL of the frontend; Paystack redirects to $APP_URL/payment/callback.
# Defaults to the first CLIENT_ORIGIN when unset.
APP_URL=http://localhost:3000

# ---- PAYMENT ----
# test     = simulated, no gateway, no money (default)
# paystack = Paystack checkout. Use a TEST secret key (sk_test_...) only.
PAYMENT_SERVICE=test
# Paystack secret key — backend only, never NEXT_PUBLIC_*, never committed.
# Also used to verify webhook signatures.
PAYSTACK_SECRET_KEY=
# A live key (sk_live_...) is refused unless this is "true". Leave false.
LIVE_PAYMENTS_ENABLED=false
# Unpaid checkouts older than this are marked expired (a later verified
# payment still completes them).
PAYMENT_EXPIRY_MINUTES=60

# ---- DELIVERY (VTU) ----
# test = simulated delivery (default). Real suppliers are not implemented yet.
VTU_SERVICE=test
# Required "true" before any real supplier can be enabled. Leave false.
LIVE_DELIVERY_ENABLED=false

# ---- PRODUCTION / VERCEL (set these in the Vercel Environment Variables UI) ----
# MONGO_URI=<MongoDB Atlas connection string>   (never commit the real value)
# JWT_SECRET=<strong private secret>
# CLIENT_ORIGIN=https://<your-vercel-domain>
# APP_URL=https://<your-vercel-domain>
# APP_URL=https://<your-vercel-domain>
# COOKIE_SECURE=true
# JWT_EXPIRES_IN=7d
# NODE_ENV=production

# ---- AUTOMATED TESTS ONLY ----
# Integration tests use a separate database whose name MUST end in _test
# (they drop it). They never use MONGO_URI. Set it in your shell, not here:
#   MONGO_URI_TEST=mongodb://127.0.0.1:27017/escriptpay_test npm run test:integration
