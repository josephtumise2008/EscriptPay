# Backend environment (copy to .env — never commit the real .env)
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/escriptpay
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Origin allowed for CORS (credentials). Change if the frontend serves elsewhere.
CLIENT_ORIGIN=http://localhost:3000
COOKIE_SECURE=false