# Frontend environment (copy to .env.local for overrides)
#
# LOCAL DEVELOPMENT — point at the Express dev server:
NEXT_PUBLIC_API_URL=http://localhost:5001
#
# PRODUCTION (Vercel) — frontend and backend share one domain, so the browser
# calls the same origin. Set this in Vercel to:
# NEXT_PUBLIC_API_URL=/api
# (a same-origin relative base; a value of "/api" is normalized internally so
# requests never become /api/api/...)
#
# Never commit real secrets here. This file must stay trackable.
